{
	"Storage": {
		"Storages": [
			{
				"Type": "Temp",
				"BasePath": "%{MyStorageBasePath}%",
				"SubPath": "temp",
				"NamingConventions": {
					"NamePattern": "{filename}.{nonce}.{extension}"
				}
			},
			{
				"Type": "DatasetFileUpload",
				"BasePath": "%{MyStorageBasePath}%",
				"SubPath": "dataset_upload",
				"NamingConventions": {
					"NamePattern": "{filename}.{nonce}.{extension}"
				}
			},
			{
				"Type": "DatasetOnboardStaging",
				"BasePath": "%{DatasetStagingBasePath}%",
				"SubPath": "dataset_staging",
				"NamingConventions": {
					"NamePattern": "{filename}.{extension}"
				}
			},
			{
				"Type": "Dataset",
				"BasePath": "%{DatasetBasePath}%",
				"SubPath": "dataset",
				"NamingConventions": {
					"NamePattern": "{filename}.{extension}"
				}
			}
		],
		"UploadRules": {
			//50ΜΒ = 52428800 bytes
			"MaxFileSize": 52428800,
			"AllowedExtensions": [ ".csv", ".xlsx", ".txt", ".pdf", ".png", ".jpeg", ".jpg", ".md", ".docx", ".pptx", ".m4a" ]
		},
		"DownloadRules": {
			//50ΜΒ = 52428800 bytes
			//310MB = 325058560 bytes
			"MaxFileSize": 325058560,
			"AllowedExtensions": null
		}
	}
}
